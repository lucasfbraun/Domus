<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            force="true" on every line here: without it, PHPUnit only applies
            an <env> value when that variable isn't already present in the OS
            environment. A test run spawned as a *child process* of an
            already-booted Laravel process (e.g. RunTestSuiteJob, run from
            inside the queue worker) inherits that parent's real environment —
            APP_ENV=local, SESSION_DRIVER=database, etc., loaded via
            phpdotenv's putenv() — so without force="true" these overrides get
            silently skipped and the suite runs against local config instead
            of testing (symptom: everything that writes fails with a 419,
            because the real database-backed session driver doesn't behave
            like the isolated per-test array driver). A plain `php artisan
            test` from a fresh shell was never affected, only nested/spawned
            runs were — see docs/adr/0008-feature-checks-page.md.
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_DATABASE" value="testing" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
